[Unit]
Description=Claude Code Remote Control server (start sessions on this Pi from the Claude app)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@HOME@/Zenko_Agent
Environment=PATH=@HOME@/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=DISPLAY=:0
ExecStart=@HOME@/.local/bin/claude remote-control
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
