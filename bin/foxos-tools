#!/usr/bin/env bash
# foxos-tools — make sure this machine has the security tools DreadFox uses, on any supported distro.
#
#   foxos-tools check                 what's present / missing (core = needed by DreadFox features)
#   foxos-tools install [--core|--all] [--yes]
#        fill gaps: distro packages first, then official ProjectDiscovery release binaries
#        (SHA-256 checked against the release checksums), then isolated pipx installs.
#   foxos-tools toolkit [--set headless|default|large|everything] [--yes]
#        make sure a security toolset is present. Without --set it recognises Kali, Parrot, BackBox, BlackArch,
#        Fedora Security Lab, Pentoo, REMnux, Exegol and hand-built collections (60%+ of ~70 common tools) and
#        installs nothing if one is found. Otherwise (or with --set) Kali's standard set (headless). On Kali:
#        Kali's metapackage via apt. Anywhere else: an official Kali container (distrobox + podman);
#        every tool it adds that the host lacks becomes a command in ~/.local/bin. Host packages untouched.
#   foxos-tools inventory
#        everything installed: toolsets and their categories, tool commands, tool folders outside the
#        package manager (~/go/bin, ~/.cargo/bin, /snap/bin, pdtm…), /opt and ~/tools projects, and which
#        of them FoxWorx's agent can see
#   foxos-tools expose
#        add those tool folders to FoxWorx's search path so its agent can use them
#   foxos-tools repo list | add kali|blackarch|wazuh | remove NAME
#        trusted toolset repositories with their official signing keys (fingerprint-pinned); Kali on
#        Debian/Ubuntu is pinned so it never replaces system packages; BlackArch via verified strap.sh
#   foxos-tools update [--auto]
#        re-apply the toolkit to pull in tools Kali has added since, then expose new ones
#   foxos-tools timer [--off]
#        weekly unattended update (container: automatic; Kali host: reminder, since apt needs sudo)
#
# Single tools land in /usr/local/bin; container tools in ~/.local/bin (both searched by FoxWorx and h1). Run as your normal user;
# it asks for sudo when needed. FOXOS_DRYRUN=1 prints the plan without changing anything.
set -uo pipefail
HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
LIB="$HERE/foxos-pkg.sh"; [ -f "$LIB" ] || LIB="$HOME/.local/share/foxos/foxos-pkg.sh"
# shellcheck source=foxos-pkg.sh
. "$LIB"
foxos_detect
BIN="${FOXOS_BIN_DIR:-/usr/local/bin}"
BOX="${FOXOS_KALI_BOX:-foxos-kali}"
C=$'\033[38;5;160m' G=$'\033[38;5;71m' Y=$'\033[38;5;178m' D=$'\033[2m' N=$'\033[0m'
say() { printf '%s[foxos-tools]%s %s\n' "$C" "$N" "$*"; }
YES=0

# cmd | tier | install methods (tried in order) | what it's for
#   pkg            distro package (names mapped per distro in foxos-pkg.sh)
#   pd:REPO        ProjectDiscovery GitHub release binary
#   pipx:SPEC      Python app in its own venv
#   kali:PKG       Kali package (inside the Kali container on non-Kali distros)
TOOLS='
nmap|core|pkg kali:nmap|port/service scanning (FoxWorx workflows)
curl|core|pkg kali:curl|HTTP checks (FoxWorx workflows)
dig|core|pkg kali:dnsutils|DNS lookups (FoxWorx, h1 recon)
whois|core|pkg kali:whois|domain ownership (FoxWorx)
openssl|core|pkg kali:openssl|TLS certificate checks (FoxWorx)
whatweb|extra|pkg kali:whatweb|web fingerprinting (FoxWorx web-fingerprint workflow)
subfinder|core|pkg pd:subfinder kali:subfinder|passive subdomains (h1 recon/hunt)
dnsx|core|pkg pd:dnsx kali:dnsx|DNS resolution at scale (h1 recon/hunt)
httpx-toolkit|core|pkg pd:httpx kali:httpx-toolkit|HTTP probing (h1 recon/hunt)
nuclei|core|pkg pd:nuclei kali:nuclei|template checks (h1 hunt)
tor|core|pkg|Dens (peer-to-peer over Tor; always from your distro)
katana|extra|pkg pd:katana kali:katana|web crawling
amass|extra|pkg kali:amass|attack-surface mapping
theHarvester|extra|pkg kali:theharvester|OSINT (emails, hosts)
nikto|extra|pkg kali:nikto|web server checks
sqlmap|extra|pkg pipx:sqlmap kali:sqlmap|SQL injection testing
ffuf|extra|pkg kali:ffuf|web fuzzing
gobuster|extra|pkg kali:gobuster|content/DNS brute forcing
feroxbuster|extra|pkg kali:feroxbuster|recursive content discovery
wpscan|extra|pkg kali:wpscan|WordPress scanning
hydra|extra|pkg kali:hydra|online password attacks
john|extra|pkg kali:john|offline hash cracking
hashcat|extra|pkg kali:hashcat|GPU hash cracking
netexec|extra|pkg pipx:git+https://github.com/Pennyw0rth/NetExec kali:netexec|SMB/AD assessment
impacket-secretsdump|extra|pkg kali:impacket-scripts|Windows/AD protocols (impacket)
searchsploit|extra|pkg kali:exploitdb|exploit database search
msfconsole|extra|pkg kali:metasploit-framework|Metasploit
responder|extra|pkg kali:responder|LLMNR/NBT-NS capture
tcpdump|extra|pkg kali:tcpdump|packet capture
tshark|extra|pkg kali:tshark|packet analysis
masscan|extra|pkg kali:masscan|fast port scanning
sslscan|extra|pkg kali:sslscan|TLS configuration
binwalk|extra|pkg kali:binwalk|firmware analysis
exiftool|extra|pkg kali:libimage-exiftool-perl|file metadata
radare2|extra|pkg kali:radare2|reverse engineering
aircrack-ng|extra|pkg kali:aircrack-ng|Wi-Fi auditing
'

rows() { printf '%s\n' "$TOOLS" | grep '|' ; }
# Common places tools get installed outside the system PATH (Go, Rust, pdtm, snaps, user installs).
TOOL_DIRS="$HOME/.local/bin $HOME/go/bin $HOME/.cargo/bin $HOME/.pdtm/go/bin /snap/bin /usr/local/go/bin /opt/foxos/pipx/bin"
have() {
  command -v "$1" >/dev/null 2>&1 && return 0
  [ -x "$BIN/$1" ] && return 0
  local d; for d in $TOOL_DIRS; do [ -x "$d/$1" ] && [ ! -d "$d/$1" ] && return 0; done; return 1
}

# ------------------------------------------------------------------ check
cmd_check() {
  local cmd tier methods desc miss_core=0 miss_extra=0
  say "$FOXOS_NAME · $FOXOS_PM · $FOXOS_ARCH"
  while IFS='|' read -r cmd tier methods desc; do
    if have "$cmd"; then printf '  %s✓%s %-22s %s%s%s\n' "$G" "$N" "$cmd" "$D" "$desc" "$N"
    else
      printf '  %s✗%s %-22s %s %s(%s)%s\n' "$Y" "$N" "$cmd" "$desc" "$D" "$tier" "$N"
      [ "$tier" = core ] && miss_core=$((miss_core+1)) || miss_extra=$((miss_extra+1))
    fi
  done < <(rows)
  echo
  say "missing: $miss_core core, $miss_extra extra"
  [ $miss_core -gt 0 ] && say "fill core gaps:  foxos-tools install --core"
  [ $miss_extra -gt 0 ] && say "everything:      foxos-tools install --all   and the standard toolset: foxos-tools toolkit"
  local found; found=$(toolsets)
  if [ -n "$found" ]; then say "security toolsets detected:"; printf '%s\n' "$found" | while IFS='|' read -r id label upd; do printf '    • %s\n' "$label"; done
  else say "no security toolset detected — install the standard one: foxos-tools toolkit"; fi
  return 0
}

# ------------------------------------------------------------------ helpers
as_root() { if [ -w "$BIN" ] && [ "${FOXOS_FORCE_SUDO:-0}" != 1 ]; then run "$@"; else run sudo "$@"; fi; }

pd_install() (   # pd_install REPO TARGET_NAME  (subshell: its temp dir is always cleaned up)
  repo=$1 target=$2
  have unzip || pkg_ensure unzip
  tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
  # Latest version from the releases/latest redirect (not rate-limited like the API); the API is the fallback.
  ver=$(curl -fsSI --max-time 30 "https://github.com/projectdiscovery/$repo/releases/latest" 2>/dev/null \
        | tr -d '\r' | sed -n 's#^[Ll]ocation: .*/releases/tag/v\{0,1\}\([^/]*\)$#\1#p' | tail -1)
  if [ -z "$ver" ]; then
    api=$(curl -fsSL --max-time 30 "https://api.github.com/repos/projectdiscovery/$repo/releases/latest") || { echo "    GitHub unreachable"; exit 1; }
    ver=$(printf '%s' "$api" | grep -o '"tag_name": *"[^"]*"' | head -1 | sed 's/.*"v\{0,1\}\([^"]*\)"$/\1/')
  fi
  case "$ver" in ''|*[!0-9A-Za-z.+-]*) echo "    could not determine the latest $repo version"; exit 1 ;; esac
  asset="${repo}_${ver}_linux_${FOXOS_ARCH}.zip"; sums="${repo}_${ver}_checksums.txt"
  if [ "${FOXOS_DRYRUN:-0}" = 1 ]; then printf '  [dry-run] download %s (verify against %s) → %s/%s\n' "$asset" "$sums" "$BIN" "$target"; exit 0; fi
  curl -fsSL --max-time 300 -o "$tmp/$asset" "https://github.com/projectdiscovery/$repo/releases/download/v$ver/$asset" || exit 1
  curl -fsSL --max-time 60 -o "$tmp/sums" "https://github.com/projectdiscovery/$repo/releases/download/v$ver/$sums" || exit 1
  want=$(awk -v f="$asset" '$2==f{print $1}' "$tmp/sums"); got=$(sha256sum "$tmp/$asset" | cut -d' ' -f1)
  if [ -z "$want" ] || [ "$want" != "$got" ]; then echo "    checksum mismatch for $asset — not installed"; exit 1; fi
  (cd "$tmp" && unzip -q -o "$asset" "$repo") || exit 1
  as_root install -m 0755 "$tmp/$repo" "$BIN/$target" || exit 1
  echo "    $target $ver (verified sha256 ${got:0:12}…)"
)

pipx_install() {   # pipx_install SPEC CMD
  local spec=$1 cmd=$2
  have pipx || pkg_ensure pipx
  have pipx || [ "${FOXOS_DRYRUN:-0}" = 1 ] || { echo "    pipx unavailable"; return 1; }
  as_root env PIPX_HOME=/opt/foxos/pipx PIPX_BIN_DIR="$BIN" pipx install --quiet "$spec"
  have "$cmd" || [ "${FOXOS_DRYRUN:-0}" = 1 ]
}

# ------------------------------------------------------------------ install
cmd_install() {
  local scope=core cmd tier methods desc m done_ kali_left=()
  for a in "$@"; do case "$a" in --core) scope=core ;; --all) scope=all ;; --yes|-y) YES=1 ;; esac; done
  say "$FOXOS_NAME · installing ${scope} security tools that are missing"
  [ "$FOXOS_PM" = unknown ] && say "unknown package manager: only release binaries can be installed"
  pm_update
  while IFS='|' read -r cmd tier methods desc; do
    [ "$scope" = core ] && [ "$tier" != core ] && continue
    have "$cmd" && continue
    printf '  • %-22s ' "$cmd"
    done_=0
    for m in $methods; do
      case "$m" in
        pkg)
          local c found=""
          for c in $(pkgnames "$cmd"); do pm_has "$c" && { found=$c; break; }; done
          if [ -n "$found" ]; then echo "→ package $found"; pm_install "$found" && { have "$cmd" || [ "${FOXOS_DRYRUN:-0}" = 1 ]; } && { done_=1; break; }; fi ;;
        pd:*) echo "→ ProjectDiscovery release"; pd_install "${m#pd:}" "$cmd" && { done_=1; break; } ;;
        pipx:*) echo "→ pipx"; pipx_install "${m#pipx:}" "$cmd" && { done_=1; break; } ;;
        kali:*) if [ "$FOXOS_KALI" = 1 ]; then echo "→ Kali package ${m#kali:}"; pm_install "${m#kali:}" && { done_=1; break; }
                else kali_left+=("$cmd"); echo "→ comes with the standard toolkit (foxos-tools toolkit)"; done_=2; fi ;;
      esac
    done
    [ $done_ = 0 ] && echo "    could not install $cmd here"
  done < <(rows)
  if [ ${#kali_left[@]} -gt 0 ]; then
    say "${#kali_left[@]} tool(s) aren't packaged for $FOXOS_NAME: ${kali_left[*]}"
    say "they come with the standard toolkit (Kali container):  foxos-tools toolkit"
  fi
  say "done. Check with: foxos-tools check"
}

# ------------------------------------------------------------------ kali
# ------------------------------------------------------------------ standard toolkit
# Kali's metapackages are the "standard set": Kali maintains them and adds new tools to them over time,
# so re-applying one later pulls in tools that didn't exist when DreadFox was installed.
STATE="$HOME/.local/share/foxos/toolkit.env"
EXPORTS="${FOXOS_EXPORT_DIR:-$HOME/.local/bin}"
MARK='# foxos-kali-export'
META_RANK='kali-linux-headless:1 kali-linux-default:2 kali-linux-large:3 kali-linux-everything:4'
# Never expose these from the container, even if the host lacks them (shells, interpreters, package and
# system management); everything else the toolkit added is a tool.
DENY='^(sudo|su|sh|bash|dash|zsh|fish|env|login|passwd|chsh|chfn|newgrp|apt.*|dpkg.*|debconf.*|python[0-9.]*|perl[0-9.]*|ruby[0-9.]*|node|npm|java|systemctl|journalctl|loginctl|mount|umount|ldconfig|update-.*|user(add|del|mod)|group(add|del|mod)|visudo|distrobox.*|podman|docker|flatpak|snap|pip[0-9.]*|pipx|gem|xdg-.*|dbus-.*|gpg.*|ssh|sshd|scp|sftp|ssh-.*|curl|wget|git|tar|gzip|gunzip|zip|unzip|less|more|vi|vim|nano|man|which|whereis|locale.*|tzselect|x-.*|py3.*|pydoc.*|2to3.*)$'

toolkit_size() { case "$1" in kali-linux-headless) echo 12 ;; kali-linux-default) echo 25 ;; kali-linux-large) echo 35 ;; *) echo 60 ;; esac; }
rank() { local m; for m in $META_RANK; do [ "${m%%:*}" = "$1" ] && { echo "${m##*:}"; return; }; done; echo 0; }
state_get() { [ -f "$STATE" ] && sed -n "s/^$1=//p" "$STATE" | tail -1; }
state_set() { [ "${FOXOS_DRYRUN:-0}" = 1 ] && return 0; mkdir -p "$(dirname "$STATE")"; { [ -f "$STATE" ] && grep -v "^$1=" "$STATE"; echo "$1=$2"; } > "$STATE.tmp"; mv "$STATE.tmp" "$STATE"; }
free_gb() { local g; g=$(df -BG --output=avail "${1:-$HOME}" 2>/dev/null | tail -1 | tr -dc 0-9); echo "${g:-999}"; }  # unknown -> don't block

# Which standard toolkit is present? Prints the largest installed Kali metapackage (host or container).
# Largest Kali metapackage installed on the host (Kali) or in our container ('' if none).
kali_meta_installed() {
  local m best="" r=0
  if command -v dpkg-query >/dev/null; then
    for m in $META_RANK; do m=${m%%:*}
      dpkg-query -W -f='${Status}' "$m" 2>/dev/null | grep -q 'install ok installed' && [ "$(rank "$m")" -gt $r ] && { best=$m; r=$(rank "$m"); }
    done
  fi
  if [ -z "$best" ] && have distrobox && grep -qw "$BOX" <<< "$(distrobox list 2>/dev/null)"; then
    for m in $META_RANK; do m=${m%%:*}
      distrobox enter "$BOX" -- dpkg-query -W -f='${Status}' "$m" 2>/dev/null | grep -q 'install ok installed' && [ "$(rank "$m")" -gt $r ] && { best="container:$m"; r=$(rank "$m"); }
    done
  fi
  echo "$best"
}

# A broad reference list of widely used security tools, across recon, web, passwords, AD, exploitation,
# sniffing, wireless, forensics and reversing. Used to recognise hand-built collections.
REF_TOOLS='nmap masscan rustscan amass subfinder assetfinder dnsx dnsrecon dnsenum fierce theHarvester recon-ng
spiderfoot whatweb wafw00f httpx-toolkit nuclei nikto wpscan sqlmap commix ffuf gobuster feroxbuster dirb dirsearch
wfuzz burpsuite zaproxy hydra medusa ncrack john hashcat hashid cewl crunch netexec impacket-secretsdump evil-winrm
responder enum4linux smbclient smbmap ldapsearch bloodhound-python kerbrute msfconsole msfvenom searchsploit tcpdump
tshark wireshark ettercap bettercap aircrack-ng reaver bully wifite kismet hcxdumptool binwalk exiftool foremost
radare2 ghidra gdb yara sslscan testssl sslyze socat nc proxychains4'
COVERAGE_MIN=${FOXOS_COVERAGE_MIN:-60}

coverage() { local n=0 t=0 x; for x in $REF_TOOLS; do t=$((t+1)); have "$x" && n=$((n+1)); done; echo "$n $t"; }
dpkg_any() { dpkg-query -W -f='${Package} ${Status}\n' "$@" 2>/dev/null | awk '/install ok installed/{print $1}'; }

# Installed tool packages listed by a metapackage (direct deps; category metas expanded one level).
meta_deps() {
  apt-cache depends --no-recommends --no-suggests "$@" 2>/dev/null | awk '/ Depends:/{print $2}' | tr -d '<>' | sort -u
}
installed_of() { [ $# -eq 0 ] && { echo 0; return; }; dpkg-query -W -f='${Status}\n' "$@" 2>/dev/null | grep -c 'install ok installed'; }
# "installed/listed" for a metapackage family pattern, e.g. 'kali-tools-*'
family_counts() {
  local metas deps
  metas=$(dpkg_any "$1"); [ -n "$metas" ] || { echo ""; return; }
  # shellcheck disable=SC2086
  deps=$(meta_deps $metas | grep -v -E '^(kali-tools-|parrot-tools-|kali-linux-)')
  # shellcheck disable=SC2086
  echo "$(echo "$metas" | wc -l) $(installed_of $deps) $(echo "$deps" | grep -c .)"
}
# Is a Kali metapackage effectively present? Installed, or 95%+ of its tools installed some other way
# (for example through the kali-tools-* category sets).
meta_satisfied() {
  local m=$1 deps sub all n t
  dpkg-query -W -f='${Status}' "$m" 2>/dev/null | grep -q 'install ok installed' && return 0
  command -v apt-cache >/dev/null || return 1
  deps=$(meta_deps "$m"); sub=$(printf '%s\n' "$deps" | grep -E '^kali-tools-')
  # shellcheck disable=SC2086
  all=$( { printf '%s\n' "$deps" | grep -v -E '^(kali-tools-|kali-linux-|kali-system-|kali-desktop-)'; [ -n "$sub" ] && meta_deps $sub | grep -v -E '^kali-'; } | sort -u | grep .)
  t=$(echo "$all" | grep -c .); [ "$t" -gt 0 ] || return 1
  # shellcheck disable=SC2086
  n=$(installed_of $all)
  [ $((100 * n / t)) -ge 95 ]
}

# Every security toolset detected on this machine, one per line:  id|label|update
#   update = apt:PKG | pacman | dnf-group:GROUP | container | remind:TEXT
toolset_scan() {
  local m n p imgs rt
  m=$(kali_meta_installed)
  case "$m" in
    container:*) echo "kali-container|Kali ${m#container:} (container $BOX)|container" ;;
    ?*) echo "kali|Kali $m|apt:$m" ;;
  esac
  if command -v dpkg-query >/dev/null; then
    local fc nm ni nt
    fc=$(family_counts 'kali-tools-*')
    if [ -n "$fc" ]; then read -r nm ni nt <<< "$fc"
      [ "${nt:-0}" -gt 0 ] && echo "kali-categories|Kali tool categories: $nm sets, $ni of $nt tool packages installed|apt-family:kali-tools-*"; fi
    fc=$(family_counts 'parrot-tools-*')
    if [ -n "$fc" ]; then read -r nm ni nt <<< "$fc"
      [ "${nt:-0}" -gt 0 ] && echo "parrot-categories|Parrot tool categories: $nm sets, $ni of $nt tool packages installed|apt-family:parrot-tools-*"; fi
    p=$(dpkg_any 'parrot-tools*' | sort | head -1); [ -n "$(dpkg_any parrot-tools-full)" ] && p=parrot-tools-full
    [ -n "$p" ] && echo "parrot|Parrot Security ($p)|apt:$p"
    n=$(dpkg_any 'backbox-*' | wc -l); [ "$n" -gt 0 ] && echo "backbox|BackBox ($n backbox packages)|remind:sudo apt update && sudo apt full-upgrade"
  fi
  if command -v pacman >/dev/null && pacman -Sl blackarch >/dev/null 2>&1; then
    n=$(pacman -Qg blackarch 2>/dev/null | wc -l)
    [ "$n" -ge 20 ] && echo "blackarch|BlackArch ($n tools installed)|pacman"
  fi
  if command -v dnf >/dev/null && grep -qi 'security lab' <<< "$(dnf -q group list --installed 2>/dev/null)"; then
    echo "fedora-security-lab|Fedora Security Lab|dnf-group:security-lab"
  fi
  [ -d /var/db/pkg/pentoo ] && echo "pentoo|Pentoo|remind:sudo emerge --sync && sudo emerge -uDN @world"
  { [ -f /etc/remnux-version ] || have remnux; } && echo "remnux|REMnux (malware analysis)|remind:sudo remnux upgrade"
  have exegol && echo "exegol|Exegol (container toolkit)|remind:exegol update"
  for rt in podman docker; do
    have "$rt" || continue
    imgs=$($rt images --format '{{.Repository}}' 2>/dev/null | grep -E 'nwodtuhs/exegol|parrotsec/security|blackarchlinux/blackarch' | sort -u | head -3 | tr '\n' ' ')
    [ -n "$imgs" ] && echo "container-$rt|container images via $rt: ${imgs% }|remind:update those images with $rt pull"
  done
  return 0
}

# Named toolsets first; a hand-built collection (60%+ of the reference tools) only when none is recognised.
toolsets() {
  local found n t
  found=$(toolset_scan)
  if [ -n "$found" ]; then printf '%s\n' "$found"; return 0; fi
  read -r n t <<< "$(coverage)"
  [ $((100 * n / t)) -ge "$COVERAGE_MIN" ] && echo "collection|existing tool collection ($n/$t common tools)|remind:foxos-tools install --all (or adopt Kali's self-updating set: foxos-tools toolkit --set headless)"
  return 0
}

cmd_toolkit() {
  local set="" a prev="" meta found best
  for a in "$@"; do case "$a" in --yes|-y) YES=1 ;; --set=*) set=${a#--set=} ;; headless|default|large|everything) set=$a ;; esac
    [ "$prev" = --set ] && set=$a; prev=$a; done
  if [ -z "$set" ]; then
    # automatic: any recognised toolset counts; only install Kali's if nothing is there
    found=$(toolsets)
    if [ -n "$found" ]; then
      say "security toolset(s) already on this machine:"
      printf '%s\n' "$found" | while IFS='|' read -r id label upd; do printf '    • %s\n' "$label"; done
      best=$(printf '%s\n' "$found" | head -1)
      state_set TOOLKIT "${best%%|*}"; state_set TOOLKIT_LABEL "$(printf '%s' "$best" | cut -d'|' -f2)"
      state_set TOOLKIT_UPDATE "${best##*|}"
      [ "${best%%|*}" = kali-container ] && kali_export
      say "nothing to install. (Want Kali's self-updating set anyway? foxos-tools toolkit --set headless)"
      return 0
    fi
    set=headless
    say "no security toolset detected (Kali, Parrot, BackBox, BlackArch, Fedora Security Lab, Pentoo, REMnux,"
    say "Exegol, or $COVERAGE_MIN%+ of $(set -- $REF_TOOLS; echo $#) common tools) — installing Kali's standard set"
  fi
  meta="kali-linux-$set"
  [ "$(rank "$meta")" -gt 0 ] || { say "unknown toolkit '$set' (headless | default | large | everything)"; return 1; }
  if [ "$FOXOS_KALI" = 1 ] && meta_satisfied "$meta"; then
    say "$meta is effectively present: 95%+ of its tools are installed (e.g. via kali-tools-* category sets)"
    state_set TOOLKIT kali; state_set TOOLKIT_UPDATE "apt-family:kali-tools-*"; state_set TOOLKIT_LABEL "Kali tool categories (covers $meta)"
    return 0
  fi
  found=$(kali_meta_installed)
  if [ -n "$found" ] && [ "$(rank "${found#container:}")" -ge "$(rank "$meta")" ]; then
    say "Kali ${found#container:} already present (covers $meta)"
    case "$found" in container:*) state_set TOOLKIT kali-container; state_set TOOLKIT_UPDATE container; kali_export ;;
                     *) state_set TOOLKIT kali; state_set TOOLKIT_UPDATE "apt:${found}" ;; esac
    state_set TOOLKIT_LABEL "Kali ${found#container:}"
    return 0
  fi
  local need; need=$(toolkit_size "$meta")
  if [ "${FOXOS_DRYRUN:-0}" != 1 ] && [ "$(free_gb)" -lt "$need" ]; then
    say "not enough disk for $meta (needs ~${need} GB free, have $(free_gb) GB) — skipped; free space and run: foxos-tools toolkit --set $set"
    return 1
  fi
  if [ "$FOXOS_KALI" = 1 ]; then
    say "installing Kali's standard toolset: $meta (~${need} GB) — this can take a while"
    confirm "Install $meta now?" || return 0
    pm_update; pm_install "$meta" || return 1
  else
    say "$FOXOS_NAME isn't Kali: installing Kali's standard toolset ($meta, ~${need} GB) in an official"
    say "Kali container (distrobox + podman). Host packages stay untouched; its tools become normal commands."
    confirm "Set up the Kali toolkit container now?" || return 0
    have podman || pkg_ensure podman
    have distrobox || pkg_ensure distrobox
    if [ "${FOXOS_DRYRUN:-0}" != 1 ] && ! { have podman && have distrobox; }; then
      say "podman/distrobox aren't in $FOXOS_NAME's repos — install them (https://distrobox.it), then: foxos-tools toolkit"; return 1
    fi
    if [ "${FOXOS_DRYRUN:-0}" = 1 ] || ! grep -qw "$BOX" <<< "$(distrobox list 2>/dev/null)"; then
      run distrobox create --yes --name "$BOX" --image docker.io/kalilinux/kali-rolling:latest || return 1
      # remember what the bare image ships, so only toolkit binaries get exposed
      if [ "${FOXOS_DRYRUN:-0}" != 1 ]; then
        mkdir -p "$(dirname "$STATE")"
        distrobox enter "$BOX" -- sh -c 'ls -1 /usr/bin /usr/sbin 2>/dev/null' | sort -u > "$HOME/.local/share/foxos/kali-base.txt"
      fi
    fi
    run distrobox enter "$BOX" -- sudo apt-get update -qq
    run distrobox enter "$BOX" -- sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq "$meta" || return 1
    kali_export
  fi
  if [ "$FOXOS_KALI" = 1 ]; then state_set TOOLKIT kali; state_set TOOLKIT_UPDATE "apt:$meta"
  else state_set TOOLKIT kali-container; state_set TOOLKIT_UPDATE container; fi
  state_set TOOLKIT_LABEL "Kali $meta"
  say "standard toolkit ready: $meta. FoxWorx's agent discovers new tools automatically."
}

# Expose every tool the container's toolkit added (and the host lacks) as a wrapper in ~/.local/bin.
# Wrappers are marked, so refreshes add new tools and drop ones Kali removed, and never touch other files.
kali_export() {
  local base="$HOME/.local/share/foxos/kali-base.txt" list name dir added=0 removed=0 f
  if [ "${FOXOS_DRYRUN:-0}" = 1 ]; then printf '  [dry-run] expose new container tools as wrappers in %s\n' "$EXPORTS"; return 0; fi
  list=$(distrobox enter "$BOX" -- sh -c 'for d in /usr/bin /usr/sbin; do for f in "$d"/*; do [ -x "$f" ] && [ ! -d "$f" ] && echo "$f"; done; done' 2>/dev/null | tr -d '\r')
  [ -n "$list" ] || { say "could not list the container's tools"; return 1; }
  mkdir -p "$EXPORTS"
  local hostpath; hostpath=$(printf '%s' "$PATH" | tr ':' '\n' | grep -vxF "$EXPORTS" | paste -sd: -)
  declare -A keep=()
  while IFS= read -r f; do
    name=${f##*/}; dir=${f%/*}
    [[ $name =~ $DENY ]] && continue
    [ -f "$base" ] && grep -qx "$name" "$base" && continue
    if [ -e "$EXPORTS/$name" ] && ! grep -q "^$MARK" "$EXPORTS/$name" 2>/dev/null; then continue; fi  # not ours
    if [ ! -e "$EXPORTS/$name" ] && PATH="$hostpath" command -v "$name" >/dev/null 2>&1; then continue; fi  # host has it
    keep[$name]=1
    if [ ! -e "$EXPORTS/$name" ]; then
      printf '#!/bin/sh\n%s: %s from container %s (managed by foxos-tools; safe to delete)\nexec distrobox-enter -n %s -- %s "$@"\n' \
        "$MARK" "$name" "$BOX" "$BOX" "$dir/$name" > "$EXPORTS/$name"
      chmod 0755 "$EXPORTS/$name"; added=$((added+1))
    fi
  done <<< "$list"
  for f in "$EXPORTS"/*; do
    [ -f "$f" ] && grep -q "^$MARK" "$f" 2>/dev/null && [ -z "${keep[${f##*/}]:-}" ] && { rm -f "$f"; removed=$((removed+1)); }
  done
  say "container tools exposed in $EXPORTS: ${#keep[@]} total (+$added new, -$removed removed)"
}

# Pull in tools Kali added since last time (and updates), then expose any new ones.
cmd_update() {
  local auto=0 a upd label
  for a in "$@"; do [ "$a" = --auto ] && auto=1; [ "$a" = --yes ] && YES=1; done
  upd=$(state_get TOOLKIT_UPDATE); label=$(state_get TOOLKIT_LABEL)
  if [ -z "$upd" ]; then say "no toolset recorded yet — run: foxos-tools toolkit"; return 0; fi
  needs_sudo() { if [ $auto = 1 ] && ! sudo -n true 2>/dev/null; then
      command -v notify-send >/dev/null && notify-send -i security-high "FoxOS tools" "Weekly check: run 'foxos-tools update' to refresh $label." 2>/dev/null
      say "needs your sudo password — run: foxos-tools update"; return 0; fi; return 1; }
  case "$upd" in
    apt:*) needs_sudo && return 0
           say "refreshing $label (adds tools added to ${upd#apt:} since your last update)"
           pm_update; pm_install "${upd#apt:}"
           say "for newer versions of the tools themselves run: sudo apt full-upgrade" ;;
    apt-family:*) needs_sudo && return 0
           local fam; fam=$(dpkg_any "${upd#apt-family:}" | tr '\n' ' ')
           say "refreshing $label: re-applying $(echo $fam | wc -w) category sets (adds tools added to them since)"
           # shellcheck disable=SC2086
           pm_update; pm_install $fam
           say "for newer versions of the tools themselves run: sudo apt full-upgrade" ;;
    pacman) needs_sudo && return 0; say "updating $label"; run sudo pacman -Syu --noconfirm ;;
    dnf-group:*) needs_sudo && return 0; say "updating $label"; run sudo dnf group upgrade -y "${upd#dnf-group:}" ;;
    container)
      have distrobox || { say "distrobox missing — run: foxos-tools toolkit"; return 1; }
      local meta; meta=$(distrobox enter "$BOX" -- sh -c "dpkg-query -W -f='\${Package}\n' 'kali-linux-*' 2>/dev/null" | grep -E 'headless|default|large|everything' | head -1)
      say "updating the Kali toolkit container (${meta:-kali-linux-headless})…"
      run distrobox enter "$BOX" -- sudo apt-get update -qq
      run distrobox enter "$BOX" -- sudo env DEBIAN_FRONTEND=noninteractive apt-get full-upgrade -y -qq
      run distrobox enter "$BOX" -- sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq "${meta:-kali-linux-headless}"
      kali_export ;;
    remind:*)
      if [ $auto = 1 ]; then
        command -v notify-send >/dev/null && notify-send -i security-high "FoxOS tools" "Weekly check for $label: ${upd#remind:}" 2>/dev/null
      fi
      say "$label is updated with its own tooling: ${upd#remind:}" ;;
  esac
  state_set LAST_UPDATE "$(date +%F)"
}

# Weekly unattended update (container: fully automatic; Kali host: a reminder, since apt needs sudo).
cmd_timer() {
  local u="$HOME/.config/systemd/user" self; self="$(readlink -f "$0")"
  if ! systemctl --user show-environment >/dev/null 2>&1; then
    command -v crontab >/dev/null || { say "no systemd user session and no cron: run 'foxos-tools update' yourself now and then"; return 0; }
    if [ "${1:-}" = --off ]; then crontab -l 2>/dev/null | grep -v 'foxos-tools update' | crontab -; say "weekly tool updates off"; return; fi
    ( crontab -l 2>/dev/null | grep -v 'foxos-tools update'; echo "17 4 * * 0 $self update --auto >/dev/null 2>&1" ) | crontab -
    say "weekly tool updates on (cron, Sundays 04:17)"; return
  fi
  [ "${1:-}" = --off ] && { run systemctl --user disable --now foxos-tools-update.timer; say "weekly tool updates off"; return; }
  mkdir -p "$u"
  printf '[Unit]\nDescription=FoxOS weekly security toolkit update\n\n[Service]\nType=oneshot\nEnvironment=PATH=%s/.local/bin:/usr/local/bin:/usr/bin:/bin\nEnvironment=DISPLAY=:0\nEnvironment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%s/bus\nExecStart=%s update --auto\n' \
    "$HOME" "$(id -u)" "$self" > "$u/foxos-tools-update.service"
  printf '[Unit]\nDescription=FoxOS weekly security toolkit update\n\n[Timer]\nOnCalendar=weekly\nRandomizedDelaySec=6h\nPersistent=true\n\n[Install]\nWantedBy=timers.target\n' \
    > "$u/foxos-tools-update.timer"
  run systemctl --user daemon-reload
  run systemctl --user enable --now foxos-tools-update.timer && say "weekly tool updates on (foxos-tools-update.timer)"
}

# ------------------------------------------------------------------ inventory / expose
SE="$HOME/.config/foxworx-workbench/settings.env"
SAFE_PATH_DIRS="/usr/local/sbin /usr/local/bin /usr/sbin /usr/bin /sbin /bin"
fw_extra() { [ -f "$SE" ] && sed -n 's/^FOXWORX_EXTRA_TOOL_PATHS="\{0,1\}\([^"]*\)"\{0,1\}$/\1/p' "$SE" | tail -1; }
fw_sees() { local d=$1 x; for x in $SAFE_PATH_DIRS $(fw_extra | tr ':' ' '); do [ "$x" = "$d" ] && return 0; done; return 1; }
exec_count() { local n=0 f; for f in "$1"/*; do [ -f "$f" ] && [ -x "$f" ] && n=$((n+1)); done; echo $n; }
exec_names() { local f out=(); for f in "$1"/*; do [ -f "$f" ] && [ -x "$f" ] && out+=("${f##*/}"); done; printf '%s ' "${out[@]:0:${2:-10}}"; }

cmd_inventory() {
  local found m deps n t pk cmds d c projects=0
  say "$FOXOS_NAME · security tool inventory"
  echo; echo "Toolsets:"
  found=$(toolsets)
  if [ -n "$found" ]; then printf '%s\n' "$found" | while IFS='|' read -r id label upd; do printf '  • %s\n' "$label"; done
  else echo "  (none recognised)"; fi
  if command -v dpkg-query >/dev/null; then
    for fam in 'kali-tools-*' 'parrot-tools-*'; do
      metas=$(dpkg_any "$fam"); [ -n "$metas" ] || continue
      echo; echo "By category (${fam%-\*}):"
      pk=""
      for m in $metas; do
        deps=$(meta_deps "$m" | grep -v -E '^(kali|parrot)-')
        # shellcheck disable=SC2086
        n=$(installed_of $deps); t=$(echo "$deps" | grep -c .)
        printf '  %-36s %3s/%-3s\n' "$m" "$n" "$t"; pk="$pk $deps"
      done
      # shellcheck disable=SC2086
      cmds=$(dpkg-query -W -f='${Package} ${Status}\n' $pk 2>/dev/null | awk '/install ok installed/{print $1}' | xargs -r dpkg -L 2>/dev/null \
             | grep -E '^/(usr/)?(s)?bin/[^/]+$' | sort -u | wc -l)
      echo "  → $cmds tool commands from these packages"
    done
  fi
  echo; echo "Tool folders outside the package manager (FoxWorx's agent: ✓ can use · ✗ can't see):"
  for d in $TOOL_DIRS; do
    [ -d "$d" ] || continue
    c=$(exec_count "$d"); [ "$c" -gt 0 ] || continue
    if fw_sees "$d"; then printf '  %s✓%s %-24s %3s  %s\n' "$G" "$N" "$d" "$c" "$(exec_names "$d" 8)"
    else printf '  %s✗%s %-24s %3s  %s\n' "$Y" "$N" "$d" "$c" "$(exec_names "$d" 8)"; fi
  done
  echo; echo "Tool projects (no single command; run them from their folder or link one into ~/.local/bin):"
  for d in /opt/* "$HOME"/tools/* "$HOME"/Tools/*; do
    [ -d "$d" ] || continue
    case "${d##*/}" in google|microsoft|containerd|foxos|resolve|brave.com|zoom|teamviewer) continue ;; esac
    projects=$((projects+1))
    entry=$(for f in "$d"/* "$d"/bin/*; do [ -f "$f" ] && { [ -x "$f" ] || head -c2 "$f" 2>/dev/null | grep -q '#!'; } && echo "${f#$d/}"; done 2>/dev/null | head -3 | tr '\n' ' ')
    printf '  • %-28s %s\n' "$d" "${entry:-(no launcher found)}"
  done
  [ $projects = 0 ] && echo "  (none)"
  local hidden=""; for d in $TOOL_DIRS; do [ -d "$d" ] && [ "$(exec_count "$d")" -gt 0 ] && ! fw_sees "$d" && hidden="$hidden $d"; done
  echo
  if [ -n "$hidden" ]; then say "FoxWorx's agent can't see:$hidden — fix with: foxos-tools expose"
  else say "FoxWorx's agent can see every tool folder above."; fi
}

# Add every tool folder that has commands to FoxWorx's search path, so the agent can use them.
cmd_expose() {
  local d cur new added=""
  [ -f "$SE" ] || { say "FoxWorx isn't configured on this machine ($SE missing)"; return 1; }
  cur=$(fw_extra); new=$cur
  for d in $TOOL_DIRS; do
    [ -d "$d" ] && [ "$(exec_count "$d")" -gt 0 ] || continue
    fw_sees "$d" && continue
    new="${new:+$new:}$d"; added="$added $d"
  done
  if [ -z "$added" ]; then say "FoxWorx already sees every tool folder"; return 0; fi
  if [ "${FOXOS_DRYRUN:-0}" = 1 ]; then printf '  [dry-run] FOXWORX_EXTRA_TOOL_PATHS="%s"\n' "$new"; return 0; fi
  [ -f "$SE.before-foxos-expose" ] || cp -p "$SE" "$SE.before-foxos-expose"
  if grep -q '^FOXWORX_EXTRA_TOOL_PATHS=' "$SE"; then sed -i "s#^FOXWORX_EXTRA_TOOL_PATHS=.*#FOXWORX_EXTRA_TOOL_PATHS=\"$new\"#" "$SE"
  else printf 'FOXWORX_EXTRA_TOOL_PATHS="%s"\n' "$new" >> "$SE"; fi
  say "FoxWorx can now use tools in:$added"
  if systemctl --user show-environment >/dev/null 2>&1; then systemctl --user try-restart foxworx-workbench.service 2>/dev/null || true
  elif bash "$HOME/FoxWorx-DreadFoxHacker/scripts/serve.sh" status >/dev/null 2>&1; then bash "$HOME/FoxWorx-DreadFoxHacker/scripts/serve.sh" restart >/dev/null 2>&1 || true; fi
  say "(previous settings saved as ${SE##*/}.before-foxos-expose)"
}

# ------------------------------------------------------------------ trusted toolset repositories
# Official signing keys, pinned by fingerprint (taken from the vendors' own keyring packages/keys).
KALI_FPRS="827C8569F2518CC677FECA1AED65462EC8D5E4C5 44C6513A8E4FB3D30875F758ED444FF07D8D0BF6"
WAZUH_FPR="0DCFCA5547B19D2A6099506096B3EE5F29111145"
REPOS="kali blackarch wazuh"

repo_info() {   # repo_info NAME -> "applies|configured|description"
  case "$1" in
    kali)
      local app=no conf=no
      [ "$FOXOS_PM" = apt ] && [ "$FOXOS_KALI" != 1 ] && app=yes
      [ "$FOXOS_KALI" = 1 ] && conf=built-in
      grep -rqsE 'kali\.(download|org)' /etc/apt/sources.list /etc/apt/sources.list.d/ && [ "$conf" = no ] && conf=yes
      echo "$app|$conf|Kali tool repository for Debian/Ubuntu, pinned so it never replaces your system packages" ;;
    blackarch)
      local app=no conf=no
      [ "$FOXOS_PM" = pacman ] && app=yes
      grep -qs '^\[blackarch\]' /etc/pacman.conf && conf=yes
      echo "$app|$conf|BlackArch repository for Arch (2,800+ tools; official strap.sh, checksum-verified)" ;;
    wazuh)
      local app=no conf=no
      case "$FOXOS_PM" in apt|dnf|zypper) app=yes ;; esac
      grep -rqs 'packages.wazuh.com' /etc/apt/sources.list /etc/apt/sources.list.d/ /etc/yum.repos.d/ /etc/zypp/repos.d/ && conf=yes
      echo "$app|$conf|Wazuh security platform (XDR/SIEM agent and manager)" ;;
  esac
}

cmd_repo() {
  local action=${1:-list} name=${2:-} r info
  for a in "$@"; do [ "$a" = --yes ] && YES=1; done
  case "$action" in
    list)
      say "trusted toolset repositories for $FOXOS_NAME ($FOXOS_PM):"
      for r in $REPOS; do
        IFS='|' read -r app conf desc <<< "$(repo_info "$r")"
        if [ "$conf" != no ]; then printf '  %s✓%s %-10s %s (%s)\n' "$G" "$N" "$r" "$desc" "$([ "$conf" = built-in ] && echo built in || echo configured)"
        elif [ "$app" = yes ]; then printf '  %s+%s %-10s %s  → foxos-tools repo add %s\n' "$Y" "$N" "$r" "$desc" "$r"
        else printf '  %s-%s %-10s %s (not for this distro)\n' "$D" "$N" "$r" "$desc"; fi
      done ;;
    add)
      [ -n "$name" ] || { say "usage: foxos-tools repo add kali|blackarch|wazuh"; return 1; }
      IFS='|' read -r app conf desc <<< "$(repo_info "$name")"
      [ -n "$desc" ] || { say "unknown repository '$name' ($REPOS)"; return 1; }
      [ "$conf" != no ] && { say "$name is already set up"; return 0; }
      [ "$app" = yes ] || { say "$name isn't for $FOXOS_NAME"; return 1; }
      "repo_add_$name" ;;
    remove)
      case "$name" in
        kali) confirm "Remove the FoxOS Kali repository files?" || return 0
              run sudo rm -f /etc/apt/sources.list.d/foxos-kali.sources /etc/apt/preferences.d/foxos-kali-pin /usr/share/keyrings/foxos-kali-archive-keyring.gpg
              pm_update ;;
        wazuh) confirm "Remove the FoxOS Wazuh repository files?" || return 0
               run sudo rm -f /etc/apt/sources.list.d/foxos-wazuh.list /usr/share/keyrings/foxos-wazuh.gpg /etc/yum.repos.d/foxos-wazuh.repo /etc/zypp/repos.d/foxos-wazuh.repo
               pm_update ;;
        blackarch) say "BlackArch is removed by deleting its [blackarch] section from /etc/pacman.conf (strap.sh added it)" ;;
        *) say "usage: foxos-tools repo remove kali|wazuh" ;;
      esac ;;
    *) say "usage: foxos-tools repo list | add NAME | remove NAME" ;;
  esac
}

# Download a key and accept it only if every primary key in it is on the pinned list.
fetch_verified_key() {   # fetch_verified_key URL OUTFILE "FPR1 FPR2..."
  local url=$1 out=$2 allowed=$3 fprs f ok=1
  have gpg || pkg_ensure gnupg
  curl -fsSL --max-time 60 -o "$out" "$url" || { say "could not download $url"; return 1; }
  fprs=$(gpg --batch --show-keys --with-colons "$out" 2>/dev/null | awk -F: '$1=="pub"{p=1;next} $1=="fpr"&&p{print $10;p=0}')
  [ -n "$fprs" ] || { say "no usable key in $url"; return 1; }
  for f in $fprs; do case " $allowed " in *" $f "*) ;; *) ok=0; say "unexpected key fingerprint $f — refusing";; esac; done
  [ $ok = 1 ] && say "key verified: $(echo $fprs | tr '\n' ' ')"
  [ $ok = 1 ]
}

repo_add_kali() {
  say "Kali's repository on $FOXOS_NAME: Kali itself warns that mixing it into Debian/Ubuntu can break a system."
  say "FoxOS pins it to priority 100, so it never upgrades or replaces your existing packages; only tools that"
  say "your distro doesn't have come from Kali. The safer alternative is the Kali container: foxos-tools toolkit."
  confirm "Add the pinned Kali repository?" || return 0
  local tmp; tmp=$(mktemp -d)
  if [ "${FOXOS_DRYRUN:-0}" = 1 ]; then printf '  [dry-run] verify https://archive.kali.org/archive-keyring.gpg against %s\n' "$KALI_FPRS"
  else fetch_verified_key https://archive.kali.org/archive-keyring.gpg "$tmp/kali.gpg" "$KALI_FPRS" || { rm -rf "$tmp"; return 1; }; fi
  run sudo install -m 0644 "$tmp/kali.gpg" /usr/share/keyrings/foxos-kali-archive-keyring.gpg
  printf 'Types: deb\nURIs: http://http.kali.org/kali\nSuites: kali-rolling\nComponents: main contrib non-free non-free-firmware\nSigned-By: /usr/share/keyrings/foxos-kali-archive-keyring.gpg\n' > "$tmp/src"
  printf 'Package: *\nPin: release o=Kali\nPin-Priority: 100\n' > "$tmp/pin"
  run sudo install -m 0644 "$tmp/src" /etc/apt/sources.list.d/foxos-kali.sources
  run sudo install -m 0644 "$tmp/pin" /etc/apt/preferences.d/foxos-kali-pin
  rm -rf "$tmp"; pm_update
  say "Kali repository added (pinned). Install a Kali-only tool normally, e.g.: sudo apt install <tool>"
}

repo_add_wazuh() {
  confirm "Add the Wazuh repository (key fingerprint ${WAZUH_FPR})?" || return 0
  local tmp; tmp=$(mktemp -d)
  if [ "${FOXOS_DRYRUN:-0}" = 1 ]; then printf '  [dry-run] verify https://packages.wazuh.com/key/GPG-KEY-WAZUH against %s\n' "$WAZUH_FPR"
  else fetch_verified_key https://packages.wazuh.com/key/GPG-KEY-WAZUH "$tmp/wazuh.asc" "$WAZUH_FPR" || { rm -rf "$tmp"; return 1; }; fi
  case "$FOXOS_PM" in
    apt) [ "${FOXOS_DRYRUN:-0}" = 1 ] || gpg --batch --dearmor -o "$tmp/wazuh.gpg" "$tmp/wazuh.asc"
         run sudo install -m 0644 "$tmp/wazuh.gpg" /usr/share/keyrings/foxos-wazuh.gpg
         echo 'deb [signed-by=/usr/share/keyrings/foxos-wazuh.gpg] https://packages.wazuh.com/4.x/apt/ stable main' > "$tmp/list"
         run sudo install -m 0644 "$tmp/list" /etc/apt/sources.list.d/foxos-wazuh.list ;;
    dnf|zypper)
         printf '[wazuh]\nname=Wazuh repository\nbaseurl=https://packages.wazuh.com/4.x/yum/\ngpgcheck=1\ngpgkey=https://packages.wazuh.com/key/GPG-KEY-WAZUH\nenabled=1\n' > "$tmp/repo"
         [ "$FOXOS_PM" = dnf ] && run sudo install -m 0644 "$tmp/repo" /etc/yum.repos.d/foxos-wazuh.repo
         [ "$FOXOS_PM" = zypper ] && run sudo install -m 0644 "$tmp/repo" /etc/zypp/repos.d/foxos-wazuh.repo ;;
  esac
  rm -rf "$tmp"; pm_update
  say "Wazuh repository added. Install e.g.: the wazuh-agent package"
}

repo_add_blackarch() {
  say "BlackArch's official setup (strap.sh) adds its repository and keyring to pacman."
  confirm "Download strap.sh, verify it against blackarch.org's published checksum and run it?" || return 0
  local tmp want got; tmp=$(mktemp -d)
  if [ "${FOXOS_DRYRUN:-0}" = 1 ]; then printf '  [dry-run] verify strap.sh sha1 from blackarch.org/downloads.html, then: sudo bash strap.sh\n'; rm -rf "$tmp"; return 0; fi
  curl -fsSL --max-time 60 -o "$tmp/strap.sh" https://blackarch.org/strap.sh || { say "download failed"; rm -rf "$tmp"; return 1; }
  want=$(curl -fsSL --max-time 30 https://blackarch.org/downloads.html | sed 's/<[^>]*>//g' | grep -o -E '[0-9a-f]{40}  strap\.sh' | head -1 | cut -d' ' -f1)
  got=$(sha1sum "$tmp/strap.sh" | cut -d' ' -f1)
  if [ -z "$want" ] || [ "$want" != "$got" ]; then say "strap.sh checksum mismatch (published ${want:-none}, got $got) — not running it"; rm -rf "$tmp"; return 1; fi
  say "strap.sh verified ($got)"
  run sudo bash "$tmp/strap.sh"; rm -rf "$tmp"
  say "BlackArch added. Its tools appear in FoxWorx's Tool store; install e.g.: sudo pacman -S blackarch-webapp"
}

confirm() { [ "$YES" = 1 ] && return 0; [ -t 0 ] || return 1; local a; read -rp "  $1 [y/N] " a; [[ "$a" =~ ^[Yy] ]]; }

# Tests source this file with FOXOS_TOOLS_NO_MAIN=1 to call the functions directly.
[ "${FOXOS_TOOLS_NO_MAIN:-0}" = 1 ] && return 0

case "${1:-check}" in
  check) shift || true; cmd_check "$@" ;;
  install) shift; cmd_install "$@" ;;
  toolkit|kali) shift; cmd_toolkit "$@" ;;
  inventory) shift; cmd_inventory "$@" ;;
  repo) shift; cmd_repo "$@" ;;
  expose) shift; cmd_expose "$@" ;;
  update) shift; cmd_update "$@" ;;
  timer) shift; cmd_timer "$@" ;;
  -h|--help|help) sed -n 2,31p "$0" ;;
  *) echo "usage: foxos-tools check | inventory | expose | repo … | install [--core|--all] | toolkit [--set …] | update | timer [--off]"; exit 1 ;;
esac
