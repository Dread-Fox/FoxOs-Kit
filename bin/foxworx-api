#!/usr/bin/env python3
"""Tiny FoxWorx client for the FoxOS setup wizard (no-login local mode only).

  foxworx-api status                       print mode / version / AI selection / pet as JSON
  foxworx-api select PROVIDER MODEL ENDPOINT   e.g. select lmstudio zenko-main lmstudio-local
  foxworx-api hatch [NAME]                 hatch the DreadFox (and optionally name it)

Talks to http://127.0.0.1:<FOXWORX_PORT from settings.env, default 8765> with the same Origin and
CSRF headers the browser uses. Exits 2 when FoxWorx is not reachable, 3 when it requires sign-in.
"""
import json
import os
import re
import sys
import urllib.error
import urllib.request

CONFIG = os.path.expanduser("~/.config/foxworx-workbench/settings.env")


def base_url():
    port = "8765"
    try:
        for line in open(CONFIG):
            m = re.match(r'\s*FOXWORX_PORT\s*=\s*"?(\d+)"?\s*$', line)
            if m:
                port = m.group(1)
    except OSError:
        pass
    return f"http://127.0.0.1:{port}"


BASE = base_url()


def call(method, path, body=None, csrf=None):
    headers = {"Origin": BASE}
    data = None
    if body is not None:
        data = json.dumps(body).encode()
        headers["Content-Type"] = "application/json"
    if csrf:
        headers["X-FOXWORX-CSRF"] = csrf
    req = urllib.request.Request(BASE + path, data=data, method=method, headers=headers)
    try:
        with urllib.request.urlopen(req, timeout=20) as r:
            return json.load(r)
    except urllib.error.HTTPError as e:
        if e.code == 401:
            sys.exit(3)
        detail = e.read().decode(errors="replace")[:300]
        sys.stderr.write(f"FoxWorx {method} {path}: HTTP {e.code} {detail}\n")
        sys.exit(1)
    except (urllib.error.URLError, OSError):
        sys.exit(2)


def session():
    return call("GET", "/api/session")


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    cmd = argv[0]
    if cmd == "status":
        mode = call("GET", "/api/auth-mode")
        s = session()
        ai = call("GET", "/api/ai/settings")
        pet = call("GET", "/api/pet")
        sel = ai.get("selected") or {}
        print(json.dumps({"mode": mode.get("mode"), "version": mode.get("version"),
                          "ai": {k: sel.get(k) for k in ("provider", "model", "endpoint_id")}, "ai_ready": bool(ai.get("ready")),
                          "pet_hatched": bool(pet.get("hatched")), "pet_name": pet.get("name"),
                          "actor": s.get("actor")}))
        return 0
    if cmd == "select" and len(argv) == 4:
        s = session()
        call("PUT", "/api/ai/settings", {"provider": argv[1], "model": argv[2], "endpoint_id": argv[3]}, s["csrf"])
        print(f"FoxWorx AI set to {argv[1]} / {argv[2]} ({argv[3]})")
        return 0
    if cmd == "hatch":
        s = session()
        pet = call("GET", "/api/pet")
        if not pet.get("hatched"):
            call("POST", "/api/pet/hatch", {}, s["csrf"])
        if len(argv) > 1 and argv[1].strip():
            call("PUT", "/api/pet/name", {"name": argv[1].strip()[:40]}, s["csrf"])
        print("DreadFox hatched" + (f" as {argv[1].strip()[:40]}" if len(argv) > 1 and argv[1].strip() else ""))
        return 0
    print(__doc__)
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
